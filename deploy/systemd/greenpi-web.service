[Unit]
Description=GreenPi web app (gunicorn, port 80)
After=network.target

[Service]
User=admin
Group=admin
WorkingDirectory=/home/admin/greenpi
EnvironmentFile=/etc/greenpi/greenpi.env
ExecStart=/home/admin/greenpi/venv/bin/gunicorn config.wsgi:application --bind 0.0.0.0:80 --workers 2 --timeout 60 --access-logfile -
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
